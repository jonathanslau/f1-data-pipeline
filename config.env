# Race selection
F1_SEASON=2024
F1_EVENT=British Grand Prix
F1_SESSION=R

# Replay speed (10 = 10x real-time)
SPEED_MULTIPLIER=5

# Number of drivers to track
NUM_DRIVERS=5

# Sort drivers by: GridPosition (starting) or Position (finishing)
DRIVER_SORT=GridPosition

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TELEMETRY_TOPIC=f1.telemetry
KAFKA_LAPS_TOPIC=f1.laps
